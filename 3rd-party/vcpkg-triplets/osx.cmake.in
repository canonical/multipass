set(VCPKG_TARGET_ARCHITECTURE @VCPKG_HOST_ARCH@)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)

@VCPKG_BUILD_TYPE_SETTING@
set(VCPKG_OSX_DEPLOYMENT_TARGET "@CMAKE_OSX_DEPLOYMENT_TARGET@")

# Fail any port that calls an API newer than the deployment target without an availability check,
# rather than silently weak-linking it (it would resolve to NULL and crash on older macOS)
set(VCPKG_C_FLAGS "-Werror=unguarded-availability-new")
set(VCPKG_CXX_FLAGS "-Werror=unguarded-availability-new")

# The macOS 27 SDK declares pipe2 (macOS 27.0+), which some ports would otherwise detect and call
# unguarded. Make them fall back to pipe() + FD_CLOEXEC instead.
if(PORT STREQUAL "dbus")
    list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS "-DHAVE_PIPE2=OFF")
elseif(PORT STREQUAL "gettext")
    # Take gnulib's "available in a future OS version" path, so it uses its own rpl_pipe2, which
    # does not call pipe2. Merely setting ac_cv_func_pipe2=no would leave callers using the
    # SDK-declared pipe2.
    list(APPEND VCPKG_CONFIGURE_MAKE_OPTIONS "gl_cv_onwards_func_pipe2=future")
endif()
