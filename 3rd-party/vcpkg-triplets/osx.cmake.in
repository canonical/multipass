set(VCPKG_TARGET_ARCHITECTURE @VCPKG_HOST_ARCH@)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)

@VCPKG_BUILD_TYPE_SETTING@
set(VCPKG_OSX_DEPLOYMENT_TARGET "@CMAKE_OSX_DEPLOYMENT_TARGET@")

# Fail any port that calls an API newer than the deployment target without an availability check,
# rather than silently weak-linking it (it would resolve to NULL and crash on older macOS)
set(VCPKG_C_FLAGS "-Werror=unguarded-availability-new")
set(VCPKG_CXX_FLAGS "-Werror=unguarded-availability-new")
