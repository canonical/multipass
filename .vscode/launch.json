{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "daemon",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "multipassd"
            }
        },
        {
            "id": "cli",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "multipass"
            }
        },
        {
            "id": "gui",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "multipass_gui"
            }
        },
        {
            "id": "cli_args",
            "type": "promptString",
            "description": "Arguments for the CLI",
            "default": ""
        }
    ],
    "configurations": [
        {
            "name": "Debug CLI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:cli}",
            "cwd": "${workspaceFolder}/build",
            "args": [
                "${input:cli_args}"
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug GUI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:gui}",
            "cwd": "${workspaceFolder}/build",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to daemon",
            "type": "cppdbg",
            "request": "attach",
            "program": "${input:daemon}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}