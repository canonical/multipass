{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "daemon",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "multipassd"
            }
        },
        {
            "id": "cli",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "multipass"
            }
        },
        {
            "id": "gui",
            "type": "command",
            "command": "cmake.cacheVariable",
            "args": {
                "name": "MULTIPASS_GUI_EXECUTABLE_FULL_PATH"
            }
        },
        {
            "id": "gui_folder",
            "type": "command",
            "command": "cmake.cacheVariable",
            "args": {
                "name": "MULTIPASS_GUI_EXECUTABLE_FOLDER_PATH"
            }
        },
        {
            "id": "cli_args",
            "type": "promptString",
            "description": "Arguments for the CLI",
            "default": ""
        }
    ],
    "configurations": [
        {
            "name": "Debug CLI (Linux/macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:cli}",
            "cwd": "${command:cmake.buildDirectory}",
            "args": [
                "${input:cli_args}"
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "windows": {
                "presentation": {
                    "hidden": true
                }
            }
        },
        {
            "name": "Debug GUI (Linux/macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:gui}",
            "cwd": "${command:cmake.buildDirectory}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "windows": {
                "presentation": {
                    "hidden": true
                }
            }
        },
        {
            "name": "Debug daemon (Linux/macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:daemon}",
            "cwd": "${command:cmake.buildDirectory}",
            "MIMode": "gdb",
            "pipeTransport": {
                "pipeProgram": "bash",
                "pipeArgs": ["-c"],
                "debuggerPath": "if sudo -n true 2>/dev/null; then exec sudo gdb; else exec pkexec gdb; fi"
            },
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "windows": {
                "presentation": {
                    "hidden": true
                }
            }
        },
        {
            "name": "Debug CLI (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${input:cli}",
            "cwd": "${command:cmake.buildDirectory}",
            "args": [
                "${input:cli_args}"
            ],
            "presentation": {
                "hidden": true
            },
            "windows": {
                "presentation": {
                    "hidden": false
                }
            }
        },
        {
            "name": "Debug GUI (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${input:gui}",
            "cwd": "${command:cmake.buildDirectory}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${command:cmake.buildDirectory}/bin;${input:gui_folder}"
                }
            ],
            "presentation": {
                "hidden": true
            },
            "windows": {
                "presentation": {
                    "hidden": false
                }
            }
        },
        {
            "name": "Debug daemon (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${input:daemon}",
            "cwd": "${command:cmake.buildDirectory}",
            "presentation": {
                "hidden": true
            },
            "windows": {
                "presentation": {
                    "hidden": false
                }
            }
        }
    ]
}